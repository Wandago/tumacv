# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication Options
NEXT_PUBLIC_GOOGLE_AUTH=1  # Set to "1" to enable Google sign-in, empty or "0" to disable
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here

# Payment Processing (Paddle)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_paddle_client_token_here
NEXT_PUBLIC_PADDLE_ENV=sandbox  # or "production"
NEXT_PUBLIC_PADDLE_PRICE_BASIC=your_basic_price_id_here
NEXT_PUBLIC_PADDLE_PRICE_PLUS=your_plus_price_id_here
NEXT_PUBLIC_PADDLE_PRICE_PRO=your_pro_price_id_here

# Optional: Resend API Key for emails
RESEND_API_KEY=your_resend_api_key_here
MARKETING_FROM_EMAIL=your_verified_sender_email_here

# Optional: IntaSand for payments
# (Checkout uses environment detection based on PADDLE_ENV)

# Optional: Marketing channels (add as needed)
# WHATSAPP_ACCESS_TOKEN=your_whatsapp_token_here
# WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
# AFRICASTALKING_API_KEY=your_africastalking_key_here
# AFRICASTALKING_USERNAME=your_africastalking_username_here
# X_API_KEY=your_x_api_key_here
# X_API_SECRET=your_x_api_secret_here
# X_ACCESS_TOKEN=your_x_access_token_here
# X_ACCESS_SECRET=your_x_access_secret_here
# LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
# LINKEDIN_ORG_URN=your_linkedin_org_urn_here
# FACEBOOK_PAGE_ID=your_facebook_page_id_here
# FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here